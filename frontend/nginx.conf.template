server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy API to the backend service. SSE needs buffering off.
    # ${BACKEND_HOSTPORT} is rendered at container start by the nginx
    # entrypoint (envsubst): "backend:8000" via docker-compose, or the
    # backend service's internal host:port when deployed on Render.
    location /api/ {
        proxy_pass http://${BACKEND_HOSTPORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        chunked_transfer_encoding on;
    }
}
